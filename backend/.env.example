# Copy this file to .env and fill in the values before starting the backend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=staynest_db

# Generate a unique value, for example with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Optional Razorpay test credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
